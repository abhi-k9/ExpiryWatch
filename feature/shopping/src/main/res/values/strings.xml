<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The name of the list made the first time the shopping list is opened. -->
    <string name="feature_shopping_default_list_name">Shopping list</string>
    <string name="feature_shopping_add_hint">Add an item</string>
    <string name="feature_shopping_add">Add</string>
    <string name="feature_shopping_amount_tip">Start with an amount, like “2 milk” or “500 g flour”</string>
    <!-- Under the add field while typing, what will be added, e.g. "flour · 2 kg". -->
    <string name="feature_shopping_preview">%1$s · %2$s</string>
